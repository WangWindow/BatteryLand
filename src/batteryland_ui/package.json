{
  "name": "batteryland-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "check": "biome check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:workbench": "playwright test e2e/workbench.spec.ts",
    "generate:api": "openapi-typescript ../../specs/012-backend-service-protocol/contracts/core-openapi.json -o src/api/schema.ts",
    "verify": "bun run typecheck && bun run check && bun run test && bun run build"
  },
  "dependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@primer/octicons-react": "19.42.0",
    "@primer/primitives": "11.10.0",
    "@primer/react": "38.43.0",
    "@tanstack/react-query": "5.104.5",
    "@uiw/codemirror-theme-github": "4.25.12",
    "@uiw/react-codemirror": "4.25.12",
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "bun@1.4.2"
}
